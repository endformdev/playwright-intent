{
	"name": "playwright-intent",
	"version": "0.0.1",
	"description": "Natural-language Playwright steps, cached as reviewable TypeScript.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://github.com/endformdev/playwright-intent#readme",
	"bugs": {
		"url": "https://github.com/endformdev/playwright-intent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/endformdev/playwright-intent.git",
		"directory": "playwright-intent"
	},
	"author": "Oliver Stenbom <oliver@endform.dev>",
	"keywords": [
		"playwright",
		"ai",
		"testing",
		"e2e",
		"agent"
	],
	"files": [
		"dist"
	],
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test:e2e": "pnpm build && pnpm playwright test"
	},
	"peerDependencies": {
		"@playwright/test": ">=1.60.0",
		"ai": "^7.0.0"
	},
	"devDependencies": {
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"ai": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"engines": {
		"node": ">=24.0.0"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		}
	}
}
