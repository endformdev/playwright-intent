{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.options.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"noUnusedLocals": true,
		"emitDeclarationOnly": true,
		"outDir": "lib",
		"paths": {
			"playwright-intent": ["./src/index.ts"],
			"playwright-intent/file-store": ["./src/store/file-store.ts"],
			"playwright-intent/reporter": ["./src/reporter/reporter.ts"]
		}
	},
	"include": [
		"src/**/*",
		"test-unit/**/*",
		"test-e2e/**/*",
		"*.ts",
		"package.json"
	]
}
