{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.options.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"noUnusedLocals": true,
		"emitDeclarationOnly": true,
		"outDir": "lib",
		"paths": {
			"playwright-intent": ["./src/index.ts"],
			"playwright-intent/file-store": ["./src/store/file-store.ts"],
			"playwright-intent/remote-store": ["./src/remote-store/remote-store.ts"],
			"playwright-intent/reporter": ["./src/reporter/reporter.ts"],
			"@playwright-intent/cache-api": ["../cache-api/src/index.ts"],
			"@playwright-intent/cache-api/file-system": [
				"../cache-api/src/storage/file-system.ts"
			]
		}
	},
	"references": [{ "path": "../cache-api" }],
	"include": [
		"src/**/*",
		"test-unit/**/*",
		"test-e2e/**/*",
		"*.ts",
		"package.json"
	]
}
