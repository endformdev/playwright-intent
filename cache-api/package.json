{
	"name": "@playwright-intent/cache-api",
	"version": "0.0.1",
	"description": "H3-based API library for sharing Playwright Intent steps through S3-compatible storage.",
	"type": "module",
	"license": "Apache-2.0",
	"homepage": "https://github.com/endformdev/playwright-intent/tree/main/cache-api#readme",
	"bugs": {
		"url": "https://github.com/endformdev/playwright-intent/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/endformdev/playwright-intent.git",
		"directory": "cache-api"
	},
	"author": "Oliver Stenbom <oliver@endform.dev>",
	"keywords": [
		"playwright",
		"playwright-intent",
		"cache",
		"s3",
		"r2",
		"api"
	],
	"files": [
