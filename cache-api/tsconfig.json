{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../tsconfig.options.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"noUnusedLocals": true,
		"emitDeclarationOnly": true,
		"outDir": "lib"
	},
	"include": ["src/**/*", "test-unit/**/*", "*.ts", "package.json"]
}
